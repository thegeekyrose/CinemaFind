@model CinemaFind.Models.ViewModels.MovieIndexViewModel

@{
    ViewData["Title"] = "Movies";
}

<div class="container py-4">

    <div class="mb-4">
        <h1 class="display-5 fw-bold">Discover Movies</h1>
        <p class="text-muted">
            Search, explore, and discover movies.
        </p>
    </div>

    <!-- Search and filters -->
    <form asp-controller="Movies"
          asp-action="Index"
          method="get"
          class="card card-body shadow-sm mb-4">

        <div class="row g-3">
            <div asp-validation-summary="ModelOnly"
                 class="text-danger small mb-3">
            </div>

            <div class="col-12 col-md-6">
                <label class="form-label">Movie title</label>
                <input type="text"
                       name="searchQuery"
                       value="@Model.SearchQuery"
                       class="form-control"
                       placeholder="Search movies..." />
            </div>

            <div class="col-12 col-md-3">
                <label class="form-label">Genre</label>
                <select name="genreId"
                        class="form-select">
                    <option value="">All genres</option>

                    @foreach (var genre in Model.Genres)
                    {
                        <option value="@genre.Value"
                                selected="@(genre.Value == Model.SelectedGenreId?.ToString())">
                            @genre.Text
                        </option>
                    }
                </select>
            </div>


            <div class="row g-3 mb-3">

                <div class="col-12 col-md-6">
                    <label asp-for="FromYear" class="form-label">
                        Release year from
                    </label>

                    <input asp-for="FromYear"
                           type="number"
                           class="form-control"
                           placeholder="e.g. 2000"
                           min="1888"
                           max="@DateTime.Today.Year"
                           step="1" />

                    <span asp-validation-for="FromYear"
                          class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="ToYear" class="form-label">
                        Release year to
                    </label>

                    <input asp-for="ToYear"
                           type="number"
                           class="form-control"
                           placeholder="e.g. 2020"
                           min="1888"
                           max="@DateTime.Today.Year"
                           step="1" />

                    <span asp-validation-for="ToYear"
                          class="text-danger small"></span>
                </div>

            </div>


            <div class="col-12 col-md-6">
                <label class="form-label">Sort by</label>
                <select name="sortOrder"
                        class="form-select">
                    <option value="title"
                            selected="@(Model.SortOrder == "title")">
                        Title (A-Z)
                    </option>

                    <option value="year"
                            selected="@(Model.SortOrder == "year")">
                        Release year (Newest)
                    </option>
                    <option value="quick"
                            selected="@(Model.SortOrder == "quick")">
                        Title (Quick Sort)
                    </option>
                </select>
            </div>

            <div class="col-12 col-md-6 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary">
                    Apply filters
                </button>

                <a asp-controller="Movies"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Clear
                </a>
            </div>

        </div>
    </form>

    <!-- Results -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 mb-0">Movie collection</h2>

        <span class="badge bg-secondary">
            @Model.Films.Count movies
        </span>
    </div>

    @if (!Model.Films.Any())
    {
        <div class="alert alert-info">
            No movies match your search criteria.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var film in Model.Films)
            {
                <div class="col-12 col-sm-6 col-lg-4 col-xl-3">

                    <div class="card h-100 shadow-sm">

                        @if (!string.IsNullOrWhiteSpace(film.PosterUrl))
                        {
                            <img src="@film.PosterUrl"
                                 class="card-img-top"
                                 alt="Poster for @film.Title"
                                 style="height: 300px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-dark text-white d-flex
                                                    align-items-center justify-content-center"
                                 style="height: 300px;">
                                <span class="text-center px-3">
                                    @film.Title
                                </span>
                            </div>
                        }

                    <div class="card-body d-flex flex-column">

                        <h3 class="h5 card-title">
                            @film.Title
                        </h3>

                        <p class="text-muted small">
                            @(film.ReleaseDate?.Year.ToString()
                                                    ?? "Year unknown")

                        @if (film.RuntimeMinutes.HasValue)
                                {
                                    <span>
                                        · @film.RuntimeMinutes min
                                    </span>
                                }
                            </p>

                            <div class="mb-3">
                                @foreach (var link in film.FilmGenres)
                                {
                                    <span class="badge bg-secondary me-1 mb-1">
                                        @link.Genre.Name
                                    </span>
                                }
                            </div>

                            <a asp-controller="Movies"
                               asp-action="Details"
                               asp-route-id="@film.Id"
                               class="btn btn-primary mt-auto">
                                View details
                            </a>

                        </div>
                    </div>
                </div>
            }

        </div>
    }

</div>
